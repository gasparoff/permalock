{
  "name": "permalock-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w permalock && npm run build -w @permalock/astro",
    "test": "vitest run",
    "typecheck": "tsc -p packages/permalock --noEmit && tsc -p packages/astro --noEmit",
    "format": "prettier --write \"packages/*/{src,test}/**/*.ts\" \"apps/scanner/**/*.{mjs,ts}\" \"bench/*.mjs\"",
    "format:check": "prettier --check \"packages/*/{src,test}/**/*.ts\" \"apps/scanner/**/*.{mjs,ts}\" \"bench/*.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
