{
  "description": "A removed page is never redirected to another language, even when an untranslated fallback page there has the same text.",
  "lock": { "permalock": 1, "urls": {
    "/en/setup/": { "type": "page", "source": "src/content/docs/en/setup.md", "hash": "abcdefabcdefabcd", "sim": "0123456789abcdef" },
    "/fr/setup/": { "type": "page", "source": "src/content/docs/en/setup.md", "hash": "abcdefabcdefabcd", "sim": "0123456789abcdef" }
  } },
  "build": [
    { "url": "/fr/setup/", "source": "src/content/docs/en/setup.md", "hash": "abcdefabcdefabcd", "sim": "0123456789abcdef" }
  ],
  "expect": {
    "lock": { "permalock": 1, "urls": {
      "/en/setup/": { "type": "page", "source": "src/content/docs/en/setup.md", "hash": "abcdefabcdefabcd", "sim": "0123456789abcdef" },
      "/fr/setup/": { "type": "page", "source": "src/content/docs/en/setup.md", "hash": "abcdefabcdefabcd", "sim": "0123456789abcdef" }
    } },
    "orphans": ["/en/setup/"],
    "errors": []
  }
}
